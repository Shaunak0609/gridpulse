# GridPulse — environment variable template
#
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
# See docs/ENVIRONMENT.md for full documentation on every variable.
#
# Legend:
#   [REQUIRED]  the app will not start correctly without this
#   [OPTIONAL]  has a safe default — only set if you want to change the behaviour

# ── Database ──────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string for local development.
# Replace your_username and your_password with your local Postgres credentials.
# Note: docker compose up overrides this automatically — you do not need to
# change it when running via Docker Compose.
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/gridpulse

# [OPTIONAL] Only set this if you want pytest to run against a real Postgres DB
# instead of the default in-memory SQLite database.
# TEST_DATABASE_URL=postgresql://your_username:your_password@localhost:5432/gridpulse_test

# ── Auth / JWT ────────────────────────────────────────────────────────────────

# [REQUIRED] Secret key used to sign and verify JWT tokens.
# Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a different key in production — never share this value.
JWT_SECRET_KEY=your-secret-key-here

# [OPTIONAL] Signing algorithm. HS256 is the correct value — do not change it.
JWT_ALGORITHM=HS256

# [OPTIONAL] How long a login token stays valid, in minutes. Default: 60.
JWT_EXPIRE_MINUTES=60

# ── Google OAuth ──────────────────────────────────────────────────────────────

# [REQUIRED for Google sign-in] Credentials from Google Cloud Console.
# Go to: console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# [REQUIRED for Google sign-in] Must exactly match an Authorized Redirect URI
# in your Google Cloud Console OAuth credential.
# Local dev value (add this URI in Google Cloud Console):
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Frontend / CORS ───────────────────────────────────────────────────────────

# [REQUIRED] The URL of the frontend app. The backend allows CORS requests only
# from this origin. Wrong value = CORS errors in the browser.
# Local dev (Vite):         http://localhost:5173
# Docker Compose (nginx):   overridden automatically to http://localhost:3000
# Production:               https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── F1 Season ─────────────────────────────────────────────────────────────────

# [OPTIONAL] The F1 season used for standings, calendar, and data sync.
# Change this when a new season begins.
F1_SEASON=2026

# ── Email ─────────────────────────────────────────────────────────────────────

# [REQUIRED for email notifications] API key from resend.com.
# Sign up at resend.com → API Keys → Create API Key.
RESEND_API_KEY=re_your_api_key_here

# [REQUIRED for email notifications] The sender address shown to users.
# Must be a verified sender domain on your Resend account.
# During local development you can use: onboarding@resend.dev
# but Resend only allows sending to your own address with that shared domain.
EMAIL_FROM=GridPulse <noreply@yourdomain.com>

# ── AI Race Assistant ─────────────────────────────────────────────────────────

# [REQUIRED for AI chat] Provider name: groq (free) or anthropic (paid).
AI_PROVIDER=groq

# [REQUIRED for AI chat] API key for the chosen provider.
# Groq (free tier):      sign up at console.groq.com → API Keys
# Anthropic (paid):      sign up at console.anthropic.com → API Keys
AI_API_KEY=gsk_your_groq_api_key_here

# [OPTIONAL] Model to use. Must match a model available on your chosen provider.
# Groq models:      llama-3.1-8b-instant (fast), llama-3.3-70b-versatile (better)
# Anthropic models: claude-haiku-4-5-20251001 (fast, low cost)
AI_MODEL=llama-3.1-8b-instant

# To switch to Anthropic, comment out the three lines above and uncomment these:
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-haiku-4-5-20251001
