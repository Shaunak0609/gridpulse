# Local development (running uvicorn directly):
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/gridpulse
#
# Docker Compose overrides this automatically — you do not need to change it
# when using "docker compose up". The compose file sets:
#   DATABASE_URL=postgresql://gridpulse:gridpulse@db:5432/gridpulse

# Test database (optional)
# By default, pytest uses an in-memory SQLite database — the dev database is
# never touched. Set this only if you want tests to run against a real Postgres DB.
# TEST_DATABASE_URL=postgresql://gridpulse:gridpulse@localhost:5432/gridpulse_test

# JWT settings
# Generate a secret key by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google OAuth
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend URL — used for CORS.
# Local dev (uvicorn directly): http://localhost:5173
# Docker Compose: overridden automatically to http://localhost:3000
FRONTEND_URL=http://localhost:5173

# F1 season to sync from Jolpica. Change this to fetch a different season.
F1_SEASON=2026

# Resend — email provider for sending notifications
# Get your API key from https://resend.com → API Keys
# EMAIL_FROM must be a verified sender domain on your Resend account.
# During development you can use: onboarding@resend.dev (Resend's shared test address)
# but you can only send to your own email address with it.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=GridPulse <noreply@yourdomain.com>

# AI Race Assistant
# Supported providers: groq (default, free tier), anthropic
#
# --- Groq (recommended for local development — free tier available) ---
# Sign up at https://console.groq.com → API Keys → Create API Key
# Models: llama-3.1-8b-instant (fast, free), llama-3.3-70b-versatile (higher quality)
AI_PROVIDER=groq
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.1-8b-instant
#
# --- Anthropic (optional, paid) ---
# Sign up at https://console.anthropic.com → API Keys
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-haiku-4-5-20251001
