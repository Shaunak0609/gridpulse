DATABASE_URL=postgresql://your_username:your_password@localhost:5432/gridpulse

# JWT settings
# Generate a secret key by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google OAuth
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend URL — used for CORS when deploying
FRONTEND_URL=http://localhost:5173

# F1 season to sync from Jolpica. Change this to fetch a different season.
F1_SEASON=2026
